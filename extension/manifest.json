{
  "manifest_version": 3,
  "name": "Nexus Pulse Curator",
  "version": "1.0.0",
  "description": "1-Click Opportunity Curator for LinkedIn, Facebook, Instagram & Academic Notice Boards.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Curate with Nexus Pulse",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*",
        "https://*.facebook.com/*",
        "https://*.instagram.com/*",
        "https://*.x.com/*",
        "https://*.twitter.com/*",
        "http://*/*",
        "https://*/*"
      ],
      "js": ["scripts/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
