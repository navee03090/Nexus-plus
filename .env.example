# ============================================================
# NEXUS PULSE Environment Configuration
# Tagline: "Never Miss the Opportunity That Matters."
# ============================================================

# Application Environment (development, staging, production)
APP_ENV=development
DEBUG=true
ADMIN_EMAILS=navee309010@gmail.com
SECRET_KEY=change-this-to-a-secure-random-secret-in-production

# Supabase Credentials (server-side only for service role!)
SUPABASE_URL=https://ervfizmcgcatlwynupbt.supabase.co
SUPABASE_ANON_KEY=sb_publishable_IJTTMi5K-ariqsakvSrYiA_LmeINzor
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
JWT_SECRET=your_supabase_jwt_secret_here

# PostgreSQL / Supabase Database Connection
# Format: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.ervfizmcgcatlwynupbt.supabase.co:5432/postgres
# Or for local development/testing: sqlite+aiosqlite:///./nexus_pulse.db
DATABASE_URL=sqlite+aiosqlite:///./nexus_pulse.db

# Redis / Celery Task Queue
# In local development without standalone Redis server, in-memory fakeredis fallback is automatically engaged.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# AI providers: auto | local | gemini | groq
# local = Ollama / LM Studio OpenAI-compatible API (use this for qwen2.5:3b)
LLM_PROVIDER=local

# Local model. BASE_URL must end in /v1 (Cloudflare tunnels are not auto-suffixed).
LOCAL_AI_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_AI_MODEL=qwen2.5:3b
LOCAL_AI_API_KEY=not-needed
LOCAL_AI_TIMEOUT=180

# Multiple Gemini keys (comma-separated, automatic rotation on rate limits)
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2,your_gemini_key_3

# Multiple Gemini models (fallback priority order)
GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash,gemini-flash-lite-latest

# Multiple Groq keys (comma-separated, automatic rotation on rate limits)
GROQ_API_KEYS=your_groq_key_1,your_groq_key_2

# Groq models (fallback priority order)
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# Single key / model fallbacks
GEMINI_API_KEY=your_gemini_key_1
GEMINI_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# Storage Buckets in Supabase Storage
STORAGE_BUCKET=nexus-pulse-media
STORAGE_FLYERS_BUCKET=nexus-pulse-flyers
STORAGE_AVATARS_BUCKET=nexus-pulse-avatars

# CORS Configuration (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Geographic & Timezone Defaults
DEFAULT_TIMEZONE=Asia/Karachi
DEFAULT_COUNTRY=Pakistan

# Notification Providers
EMAIL_PROVIDER_KEY=your_sendgrid_or_resend_key_here
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=Nexus Pulse <alerts@nexus-pulse.org>
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Public Frontend Variables (Exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=https://ervfizmcgcatlwynupbt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_IJTTMi5K-ariqsakvSrYiA_LmeINzor
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="NEXUS PULSE"

# ============================================================
# Dual Social Ingestion Engine (Meta Official + Apify Cloud)
# ============================================================
APIFY_API_TOKEN=your_apify_api_token_here
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_VERIFY_TOKEN=nexus_pulse_meta_verify_2026
NEXT_PUBLIC_APP_TAGLINE="Never Miss the Opportunity That Matters."
